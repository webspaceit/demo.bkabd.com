APP_NAME=BKABD
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Dhaka

# MySQL — create the database first (see database/README)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=oop_exam
DB_USERNAME=oop_exam
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Persistent PDO connections: enable only if your host allows it (default off is safest)
DB_PERSISTENT=false

# Optional one-way database schema workflow. Leave disabled by default.
# Enable only in demo.bkabd.com's private .env after setting both connections.
# The app's DB_* connection is the demo destination and should have privileges
# only on that demo database. The SYNC_SOURCE_* account is for exam metadata
# comparison and must be granted read-only access.
DB_SYNC_ENABLED=false
DB_SYNC_ALLOW_LOCAL=false
SYNC_TARGET_HOST=
SYNC_TARGET_PORT=3306
SYNC_TARGET_DATABASE=
SYNC_TARGET_USERNAME=
SYNC_TARGET_PASSWORD=
SYNC_SOURCE_HOST=
SYNC_SOURCE_PORT=3306
SYNC_SOURCE_DATABASE=
SYNC_SOURCE_USERNAME=
SYNC_SOURCE_PASSWORD=

# Session
# Session lifetime in minutes (1440 = 24 hours)
SESSION_LIFETIME=1440
# Set to true on HTTPS hosts so the session cookie is only sent over TLS
# (leave false for plain-HTTP localhost during development)
SESSION_SECURE=false

# Cache driver: file | apcu  (keep 'file' in production — shared across FPM workers)
CACHE_DRIVER=file
CACHE_TTL=60

# SMS gateway (mram) — fill real key in production
SMS_API_URL=https://sms.mram.com.bd/smsapi
SMS_API_KEY=CHANGE_ME
SMS_SENDER_NORMAL=8809601002953
SMS_SENDER_MASK=BKABD
# Set to 1 to log SMS instead of sending (safe default for new installs)
SMS_DRY_RUN=1

# Refuse logins that use a known default password (default: on unless APP_ENV=local)
# BLOCK_DEFAULT_PASSWORDS=true

# Local test login for tools/test_*.php (gitignored — never commit real values)
TEST_ADMIN_EMAIL=mehedi@gmail.com
TEST_ADMIN_PASSWORD=
