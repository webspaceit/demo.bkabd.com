{
    "name": "bkabd/oop-exam",
    "description": "BKABD Scholarship Exam Management System - Plain PHP OOP + Ajax clone",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-gd": "*",
        "ext-pdo_mysql": "*",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^1.29 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
