# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp

# ---- local Windows helper scripts (keep on developer PC, not on VPS) ----
/push-project.bat
/start.bat

# ---- environment (never publish credentials) ----
.env

# ---- composer dependencies: install on the server (`composer install`) ----
/vendor/

# ---- dev scratch / probe scripts (never publish) ----
/tmp/
/database/exports/
/php_server.log
/storage/centers-missing-*.jpg
/storage/codex-video-*
/storage/nothing-pending-*
/storage/nothing-to-migrate-contact.jpg
/storage/pending-count-video.png

# ---- build artifacts (never publish source maps) ----
*.map
*.ts

# ---- runtime artifacts: created on the server; dirs kept via .gitkeep ----
/storage/cache/*
/storage/logs/*
/storage/uploads/*
/public/uploads/*
/public/images/result-signatures/*
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep
!/storage/uploads/.gitkeep
!/public/uploads/.gitkeep
!/public/images/result-signatures/.gitkeep
# .htaccess hardening for uploaded files must ship with the repo
!/public/uploads/.htaccess
